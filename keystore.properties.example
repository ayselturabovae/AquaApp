# ===== ПРИМЕР keystore.properties (СКОПИРУЙТЕ В keystore.properties И ЗАПОЛНИТЕ) =====
# Этот файл НЕ коммитится в git (см. .gitignore)
# Локально Gradle читает пароли отсюда
# На сервере (GitHub Actions) пароли берутся из переменных окружения (Secrets)

KEYSTORE_PASSWORD=ваш_пароль_keystore
KEY_ALIAS=ваш_alias
KEY_PASSWORD=ваш_пароль_ключа